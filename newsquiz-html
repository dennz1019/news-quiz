function startTimer(){if(!state.start&&!state.done){state.start=Date.now();save(state)}}

function tick(){
  if(!state.start){time.textContent=SECONDS;return}
  var stop=state.done?(state.end||Date.now()):Date.now(),left=Math.max(0,SECONDS-Math.floor((stop-state.start)/1000));
