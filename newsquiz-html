  if(!state.done&&left<=0){state.done=true;state.timeout=true;state.end=Date.now();save(state);location.assign(resultUrl())}
}

function showExplanation(ok,text){
  explain.className=ok?"explain on":"explain on bad";
  explain.innerHTML=(ok?"<strong>Correct.</strong> ":"<strong>Answer review.</strong> ")+text;
}

function updateNav(){
  prev.hidden=q<=1;
  next.hidden=!state.a[q];
  next.textContent=q===TOTAL?"Submit Quiz":"Next Question →";
  nav.className=q<=1?"nav single":"nav";
