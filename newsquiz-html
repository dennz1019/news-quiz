      b.disabled=true;
      if(v===x.c)b.classList.add("correct");
      else if(v===old.v)b.classList.add("wrong");
      else b.classList.add("dim");
    }else b.onclick=function(){choose(v,order)};
    answers.appendChild(b);
  });
  if(old)showExplanation(old.ok,x.e);
  updateNav();dashboard();
