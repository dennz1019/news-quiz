c:"Seven",
a:["Seven","Three","Twelve","Twenty-five"],
e:"The Justice Department moved to seize seven internet domains that it said helped Chinese hackers scan and attack critical infrastructure. The action targeted infrastructure linked to Integrity Technology Group and the hacking group known as Flax Typhoon."
},
{
q:"Which fish is commonly used in U.S. fish sticks, imitation crab and McDonald’s Filet-O-Fish sandwiches?",
cue:"The species supports the world’s second-largest fishery and is caught extensively in the Bering Sea.",
c:"Alaska pollock",
a:["Pacific halibut","Atlantic cod","Alaska pollock","Chinook salmon"],
e:"Alaska pollock is used in fish sticks, imitation crab and U.S. Filet-O-Fish sandwiches. Its enormous Bering Sea fishery has become politically contentious because trawl nets also catch salmon and other unintended marine life."
}
];

var p=new URLSearchParams(location.search),rawPage=p.get("quizpage"),rawQ=p.get("q"),isResult=p.get("result")==="1";

function base(){return location.origin+location.pathname}
function pageForQuestion(n){return n<=3?1:n<=6?2:3}
function pageStart(n){return[1,4,7][n-1]}
function pageEnd(n){return[3,6,10][n-1]}
function pageUrl(n){return(n===1?base():base()+"?quizpage="+n)+"#quiz-stage"}
function resultUrl(){return base()+"?result=1#quiz-stage"}

var legacyQ=rawQ===null?0:parseInt(rawQ,10),page=rawPage===null?1:parseInt(rawPage,10);

if(rawQ!==null){
  if(!Number.isFinite(legacyQ)||legacyQ<1||legacyQ>TOTAL){location.replace(base());return}
  location.replace(pageUrl(pageForQuestion(legacyQ)));return;
}
if(!isResult&&(!Number.isFinite(page)||page<1||page>PAGES||Math.floor(page)!==page)){location.replace(base());return}
if(!isResult&&page===1&&rawPage!==null){location.replace(base());return}

function empty(){return{a:{},c:0,start:0,end:0,done:false,timeout:false}}
function load(){try{return Object.assign(empty(),JSON.parse(sessionStorage.getItem(KEY)||"{}"))}catch(e){return empty()}}
function save(state){try{sessionStorage.setItem(KEY,JSON.stringify(state))}catch(e){}}
function answered(state){return Object.keys(state.a).length}
function firstUnanswered(state){for(var i=1;i<=TOTAL;i++)if(!state.a[i])return i;return TOTAL+1}
function shuffle(a){var x=a.slice();for(var i=x.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=x[i];x[i]=x[j];x[j]=t}return x}

var state=load(),open=firstUnanswered(state);

if(!isResult&&open<=TOTAL&&page>pageForQuestion(open)){location.replace(pageUrl(pageForQuestion(open)));return}
if(isResult&&!state.done&&answered(state)<TOTAL){location.replace(pageUrl(pageForQuestion(firstUnanswered(state))));return}

var start=pageStart(page),end=pageEnd(page),q=open>=start&&open<=end?open:(open>end?end:start);
var $=function(id){return document.getElementById(id)},
    count=$("count"),time=$("time"),correct=$("correct"),fill=$("fill"),progress=$("progress"),
