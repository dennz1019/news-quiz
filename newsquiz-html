function choose(v,order){
  if(state.a[q]||state.done)return;
  startTimer();
  var x=qs[q-1],ok=v===x.c;
  state.a[q]={v:v,ok:ok,o:order};
  if(ok)state.c++;
  if(answered(state)===TOTAL){state.done=true;state.end=Date.now()}
  save(state);renderQuestion();tick();
}

function moveTo(n){
  if(n<1||n>TOTAL)return;
  var targetPage=pageForQuestion(n);
  if(targetPage===page){q=n;renderQuestion();$("quiz-stage").scrollIntoView({behavior:"auto",block:"start"})}
  else location.assign(pageUrl(targetPage));
}

prev.onclick=function(){if(q>1)moveTo(q-1)};
next.onclick=function(){
  if(!state.a[q])return;
  if(q<TOTAL)moveTo(q+1);else location.assign(resultUrl());
};

function addReviewItem(x,i){
  var old=state.a[i+1],item=document.createElement("article"),label=document.createElement("p"),title=document.createElement("h4"),visitor=document.createElement("p"),correctAnswer=document.createElement("p"),education=document.createElement("p");
  item.className="review-item "+(old&&old.ok?"was-right":"was-wrong");
  label.className="review-label";label.textContent="Question "+(i+1);
  title.className="review-q";title.textContent=x.q;
  visitor.className="review-line";visitor.innerHTML="<strong>Your answer:</strong> ";visitor.appendChild(document.createTextNode(old?old.v:"No answer"));
  correctAnswer.className="review-line";correctAnswer.innerHTML="<strong>Correct answer:</strong> ";correctAnswer.appendChild(document.createTextNode(x.c));
  education.className="review-explanation";education.textContent=x.e;
  item.appendChild(label);item.appendChild(title);item.appendChild(visitor);item.appendChild(correctAnswer);item.appendChild(education);
  $("reviewList").appendChild(item);
}

function renderResults(){
  questionView.hidden=true;results.hidden=false;
  var title=state.c>=9?"Headline Expert":state.c>=8?"Newsroom Pro":state.c>=7?"Informed Reader":state.c>=5?"Daily News Tracker":"News Catch-Up";
  $("score").textContent=state.c+"/"+TOTAL;
  $("rank").textContent=title;
  $("message").textContent=(state.timeout?"The 150-second timer expired. ":"")+(state.c>=8?"Excellent command of today’s major U.S. stories.":state.c>=5?"Good work—you followed many of today’s major headlines.":"Use the complete review below, then replay to improve your score.");
  $("reviewList").textContent="";qs.forEach(addReviewItem);dashboard();
}

$("restart").onclick=function(){try{sessionStorage.removeItem(KEY)}catch(e){}location.assign(base())};

tick();setInterval(tick,1000);
if(isResult)renderResults();else renderQuestion();

if(location.search){requestAnimationFrame(function(){$("quiz-stage").scrollIntoView({behavior:"auto",block:"start"})})}
})();
