function renderQuestion(){
  questionView.hidden=false;results.hidden=true;
  var x=qs[q-1],old=state.a[q],order=old&&old.o?old.o:shuffle(x.a);
  question.textContent=x.q;cue.textContent=x.cue;
  answers.textContent="";explain.className="explain";explain.textContent="";
  order.forEach(function(v){
    var b=document.createElement("button");
    b.type="button";b.className="answer";b.textContent=v;
